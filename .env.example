# Copy this file to .env.local in the project root.
# The Go server reads .env.local at startup. Existing environment variables take precedence.
# Recommended alternative when Brave is unavailable: https://app.tavily.com
TAVILY_API_KEY=

# Optional Brave Search key: https://api-dashboard.search.brave.com/app/keys
# Tavily takes precedence when both keys are configured.
BRAVE_SEARCH_API_KEY=

# Optional local server port (default: 8080).
# PORT=8080
